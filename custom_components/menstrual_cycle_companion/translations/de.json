  "issues": {
    "migrate_config_entry": {
      "title": "Menstrual Cycle Companion: Integration Migration erforderlich",
      "description": "Die Integration **{old_domain}** wurde in **{new_domain}** umbenannt.\n\nProfil: **{entry_title}**\n\nDeine Sensordaten und der Zyklus-Verlauf bleiben nach der Migration vollständig erhalten. Klicke auf **Reparieren**, um die Migration abzuschließen.\n\n**Betroffene Sensoren:**\n- Haupt-Zyklussensor (Entity-ID bleibt unverändert)\n- Periodenprodukt-Sensor (Entity-ID bleibt unverändert)"
    }
  },
  "repairs": {
    "migrate_config_entry": {
      "step": {
        "confirm": {
          "title": "Integration migrieren",
          "description": "Hiermit wird der **{old_domain}** Konfigurationseintrag **{entry_title}** zu **{new_domain}** migriert.\n\nDeine Sensordaten, der Zyklus-Verlauf und alle Einstellungen bleiben vollständig erhalten. Die Entity-IDs der Sensoren ändern sich nicht.\n\nKlicke auf **Senden**, um die Migration zu starten."
        }
      }
    }
  },
