  "options": {
    "step": {
      "init": {
        "title": "Menstrual Cycle Companion Settings",
        "description": "Adjust cycle tracking settings. Changes are saved immediately.",
        "data": {
          "friendly_name": "Display name",
          "icon": "Icon (optional, e.g. mdi:calendar-heart)",
          "period_duration_days": "Period duration (days)",
          "pregnancy_enabled": "Enable pregnancy mode",
          "pregnancy_start_date": "Pregnancy start date (YYYY-MM-DD)",
          "pre_menarche_enabled": "Enable pre-menarche tracking",
          "estimated_menarche_date": "Estimated menarche date (YYYY-MM-DD)",
          "family_menarche_age": "Family menarche age (8–20, optional)",
          "menopause_enabled": "Enable menopause mode",
          "menopause_start_date": "Menopause start date (YYYY-MM-DD)",
          "cycle_length_override": "Cycle length override (days, 0 = auto)",
          "nfp_analysis_mode": "NFP analysis mode",
          "num_predictions": "Aantal toekomstige cyclusvoorspellingen"
        },
        "data_description": {
          "period_duration_days": "Number of days the period typically lasts (1–14).",
          "pregnancy_enabled": "Activates pregnancy tracking mode. The pregnancy start date is auto-filled from the last cycle start if left empty.",
          "pregnancy_start_date": "First day of last menstruation (LMP). Leave empty to use the last recorded cycle start.",
          "pre_menarche_enabled": "Track puberty signs before the first period (menarche).",
          "estimated_menarche_date": "Estimated date of the first period. Used for countdown tracking.",
          "family_menarche_age": "Age of menarche in the family (mother/sister) used to estimate the expected age.",
          "menopause_enabled": "Activates menopause tracking mode.",
          "menopause_start_date": "Date when menopause started (YYYY-MM-DD). Leave empty if unknown.",
          "cycle_length_override": "Override the automatically calculated average cycle length. Set to 0 to use the auto-calculated value from your history (recommended). Set to 20–38 to manually fix the cycle length used for fertile window and ovulation calculations.",
          "nfp_analysis_mode": "Controls how ovulation and the fertile window are calculated. 'hybrid' (default) learns from observed temperature data and falls back to the statistical formula. 'strict' only shows ovulation and the fertile window when a temperature rise is confirmed in the current cycle.",
          "num_predictions": "Aantal toekomstige cyclusstarts (1-12). Standaard: 6."
        }
      }
    },
    "error": {
